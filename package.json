{
    "name": "crate-digger",
    "version": "0.1.0",
    "description": "Find copies of a specific vinyl pressing for sale on Discogs. Ships as an MCP server and a small web UI.",
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
        "mcp": "node --env-file-if-exists=.env dist/mcp.js",
        "web": "node --env-file-if-exists=.env dist/web.js",
        "dev:web": "tsx watch --env-file-if-exists=.env src/web.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.73.0",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "fastify": "^5.12.8",
        "zod": "^4.6.7"
    }
}
