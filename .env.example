# Discogs personal access token: discogs.com -> Settings -> Developers
DISCOGS_TOKEN=

# Discogs sellers to search by default (comma-separated usernames, e.g. record stores)
DISCOGS_SELLERS=

# Optional: eBay production keyset (developer.ebay.com -> Application Keys)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional
# INVENTORY_TTL_HOURS=12
# MAX_INVENTORY_PAGES=100
# CACHE_DIR=~/.cache/crate-digger
# EBAY_ENV=production        # or sandbox
# EBAY_MARKETPLACE=EBAY_US
# CURRENCY=USD
# USER_AGENT=crate-digger/0.1 +https://github.com/<you>/crate-digger
